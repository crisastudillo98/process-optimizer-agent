# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2

# RAG
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_PATH=storage/vector_db
RAG_TOP_K=5

# Storage
BPMN_OUTPUT_PATH=storage/outputs/bpmn
REPORTS_OUTPUT_PATH=storage/outputs/reports

# Observabilidad (opcional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=process-optimizer

# Logging
LOG_LEVEL=INFO

# HITL
HITL_ENABLED=true
HITL_TIMEOUT_HOURS=24

# Auth / JWT
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30